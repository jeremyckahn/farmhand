+        expect(result).toBe(state)
+      })
+
+      test('returns state unchanged when insufficient ingredients for multiple quantities', () => {
+        const recipe = {
+          id: 'test-recipe',
+          name: 'Test Recipe',
+          ingredients: {
+            'ingredient-1': 2,
+            'ingredient-2': 1,
+          },
+        }
+        const state = testState({
+          inventory: [
+            { id: 'ingredient-1', quantity: 5 },
+            { id: 'ingredient-2', quantity: 1 },
+          ],
+          experience: 100,
+        })
+
+        const result = consumeIngredients(state, recipe as any, 3, 50)
+
+        expect(result).toBe(state)
+      })
+    })
+
+    describe('sufficient ingredients', () => {
+      test('processes ingredients for single recipe', () => {
