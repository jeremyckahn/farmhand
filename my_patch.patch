+                }: {
+                  space: number
+                  price: number
+                }) => `${dollarString(price)}: Space for ${space} kegs`,
+                tiers: PURCHASEABLE_CELLARS,
+                title: 'Buy cellar',
+              }}
+            />
+          </li>
+          {(features as any).FOREST && isForestUnlocked ? (
