+                  title: 'Buy smelter',
+                }}
+              />
+            </li>
+          ) : null}
+          <li>
+            <TierPurchase
+              {...{
+                description:
+                  'You can purchase a Composter to turn weeds into fertilizer.',
+                onBuyClick: handleComposterPurchase,
+                maxedOutPlaceholder: "You've already purchased the composter!",
+                purchasedTier: purchasedComposter,
