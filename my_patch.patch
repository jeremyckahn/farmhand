+
+  describe('conditional UI based on stageFocus', () => {
+    test('shows inventory view when stageFocus is SHOP', () => {
+      const playerInventory = [
+        testItem({ id: 'apple', name: 'Apple', quantity: 2 }),
+      ] as farmhand.item[]
+
+      render(
