+
+  const isRainbowCow = color === cowColors.RAINBOW
+
+  if (happiness < 1 / 3) {
+    return isRainbowCow ? rainbowMilk1 : milk1
+  } else if (happiness < 2 / 3) {
+    return isRainbowCow ? rainbowMilk2 : milk2
+  }
+
+  return isRainbowCow ? rainbowMilk3 : milk3
+}
