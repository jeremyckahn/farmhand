+    }}
+  >
+    {children}
+  </Tooltip>
+)
+
+export const Field = (props: FieldProps) => {
+  const {
+    field,
+    fieldMode: propsFieldMode,
+    handleFieldActionRangeChange,
+    hoveredPlotRangeSize,
+    inventory,
+    inventoryLimit,
+    purchasedField,
