+export const getFinalCropItemIdFromSeedItemId = (
+  seedItemId: string,
+  variationIdx: number = 0
+): string | undefined => {
+  const { growsInto } = itemsMap[seedItemId]
+
+  if (Array.isArray(growsInto)) {
