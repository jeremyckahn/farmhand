+        })
+      })
+
+      test('sale is reduced by remaining loan balance', () => {
+        const state = sellKeg(
+          testState({
+            playerId: 'abc123',
+            cellarInventory: [stubKeg],
+            cellarItemsSold: {},
+            completedAchievements: {},
+            itemsSold: {},
+            learnedRecipes: {},
+            loanBalance: 1,
+            money: 1000,
+            pendingPeerMessages: [],
