+          userEvent.click(increment)
+          const total = screen.getByText('Total:')
+          await waitFor(() =>
+            expect(within(total).getByText('$20.84')).toBeInTheDocument()
+          )
+        })
+      })
+    })
+
+    describe('isSellView', () => {
+      beforeEach(() => {
+        const id = 'an-item'
+        render(
+          <Item
+            {...{
+              ...baseProps,
+              isSellView: true,
+              adjustedValue: 10.42,
+              item: testItem({ id }),
+              playerInventoryQuantities: { [id]: 4 },
