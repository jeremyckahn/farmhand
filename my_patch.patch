+  }
+
+  interface forestForageable {
+    daysOld: number
+    forageableId: 'mushroom' | 'acorn'
+  }
+
+  interface shoveledPlot {
+    isShoveled: boolean
+    daysUntilClear: number
+    oreId?: string | null
+  }
+
+  interface cow {
+    baseWeight: number
+    color: string
+    colorsInBloodline: Partial<Record<cowColors, boolean>>
+    daysOld: number
+    daysSinceMilking: number
+    daysSinceProducingFertilizer: number
+    gender: genders
+    happiness: number
+    happinessBoostsToday: number
+    id: string
