+
+        test('disables purchase buttons', () => {
+          expect(screen.getByRole('button', { name: 'Buy' })).toBeDisabled()
+        })
+      })
+
+      describe('prices', () => {
+        beforeEach(() => {
+          render(<Item {...{ ...props, money: 100 }} />)
+        })
+
+        test('displays item price', () => {
+          const buyPrice = screen.getByText('Price:')
