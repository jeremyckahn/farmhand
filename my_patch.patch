+          testState({
+            playerId: 'abc123',
+            cellarInventory: [stubKeg],
+            cellarItemsSold: {},
+            completedAchievements: {},
+            itemsSold: {},
+            learnedRecipes: {},
+            loanBalance: 1,
+            money: 1000,
+            pendingPeerMessages: [],
+            revenue: 0,
+            todaysRevenue: 0,
+            todaysNotifications: [],
+          }),
+          stubKeg
+        )
+
+        expect(state).toMatchObject({
+          todaysNotifications: [
+            { message: LOAN_PAYOFF(), severity: 'success' },
