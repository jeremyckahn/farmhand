+          inventory,
+          newDayNotifications,
+        } = processMilkingCows(state)
+
+        const { daysSinceMilking } = cow
+
+        expect(daysSinceMilking).toEqual(0)
+        expect(inventory).toEqual([{ id: 'milk-1', quantity: 1 }])
+        expect(newDayNotifications).toEqual([
