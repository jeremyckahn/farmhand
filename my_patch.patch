+
+  .harvest-mode &.can-be-harvested
+    background-color: $colorGreenOk
+
+    &:hover
+      cursor: pointer
+
+  .mine-mode &.can-be-mined
+    background-color: $colorGreenOk
+
+    &:hover
+      cursor: pointer
+      border-color: $colorYellow
+
